<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: the Baton mark on its brand navy. The Flutter splash takes over from the same colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/baton_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/baton_splash_mark" />
    </item>
</layer-list>
